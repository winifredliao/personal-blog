# Copy this file to .env and fill in real values before deploying.
# Without a .env, the backend falls back to a random SECRET_KEY (invalidated
# on every restart) and the default password "admin123" — fine for trying
# things out locally, not for anything reachable by anyone else.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# Comma-separated list of frontend origins allowed to call the API
# (only needed when frontend and backend are on different domains).
ALLOWED_ORIGINS=

# Cloudflare R2 — used for image uploads in the post editor.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The public base URL images are served from (custom domain or r2.dev URL).
R2_PUBLIC_URL=
